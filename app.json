{
  "expo": {
    "name": "Pear Snake",
    "slug": "snake",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#001601",
    "plugins": [
      ["pear-runtime-react-native"],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#001601",
          "image": "./assets/splash-blank.png",
          "imageWidth": 200
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pears.snake"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#001601"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pears.snake"
    },
    "extra": {
      "iosAppStoreId": ""
    }
  }
}
